# OpenSSL config for the lab Intermediate CA.
# The CSR is generated with this file; the signing extensions (v3_intermediate_ca)
# are applied by the Root CA when signing.
[ req ]
default_bits        = 4096
default_md          = sha256
prompt              = no
distinguished_name  = dn

[ dn ]
O  = ${CERT_ORG}
OU = ${CERT_ORG_UNIT}
CN = kafka-intermediate-ca

[ v3_intermediate_ca ]
basicConstraints       = critical, CA:TRUE, pathlen:0
keyUsage               = critical, keyCertSign, cRLSign
subjectKeyIdentifier   = hash
authorityKeyIdentifier = keyid:always
