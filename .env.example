###############################################################################
# Kafka / ZooKeeper Docker Compose Lab
# Apache Kafka 3.9.2 + Apache ZooKeeper 3.9.5  (ZooKeeper mode, NOT KRaft)
#
# Copy this file to .env and adjust values:
#     cp .env.example .env
#
# NEVER commit a real .env — it is git-ignored on purpose.
###############################################################################

###############################################################################
# Versions
###############################################################################

# Kafka version used for the ZooKeeper-based Kafka branch.
# Do not use Kafka 4.x in this branch because Kafka 4.x is KRaft-only
# (ZooKeeper mode was removed in Kafka 4.0). KRaft lives in a separate branch.
KAFKA_VERSION=3.9.2

# Kafka Scala build version. 3.9.2 ships as kafka_2.13-3.9.2.tgz.
SCALA_VERSION=2.13

# ZooKeeper version used for the external ZooKeeper ensemble.
ZOOKEEPER_VERSION=3.9.5

###############################################################################
# Cluster Sizing
###############################################################################

# Number of Kafka brokers to generate.
# Minimum supported value: 3
# Examples: 3, 5, 7, 10
BROKER_COUNT=3

# Number of ZooKeeper nodes.
# Supported values: 3 or 5 (must be odd for a healthy quorum).
# Default: 3
# Do NOT scale ZooKeeper one-to-one with Kafka brokers.
ZOOKEEPER_COUNT=3

# Logical cluster name (informational; used in labels/docs).
KAFKA_CLUSTER_NAME=kafka-zookeeper-lab

###############################################################################
# Security Mode
###############################################################################

# Controls which Kafka listeners are enabled.
#
# Supported values:
#   plaintext = only PLAINTEXT listener on 9092
#   ssl       = only SSL listener on 9093
#   dual      = both PLAINTEXT and SSL listeners
#
# Recommended lab default: dual
KAFKA_SECURITY_MODE=dual

# Controls which listener brokers use to communicate with each other.
#
# Recommended:
#   SSL       when KAFKA_SECURITY_MODE=ssl or dual
#   PLAINTEXT when KAFKA_SECURITY_MODE=plaintext
INTER_BROKER_LISTENER_NAME=SSL

###############################################################################
# Kafka Defaults
###############################################################################

# Default number of partitions for new topics when not specified.
NUM_PARTITIONS=6

# Default replication factor.
# Keep this at 3 even when broker count is greater than 3 unless intentionally changed.
DEFAULT_REPLICATION_FACTOR=3

# Minimum number of in-sync replicas required for successful writes.
MIN_INSYNC_REPLICAS=2

# Internal Kafka topic replication factors.
OFFSETS_TOPIC_REPLICATION_FACTOR=3
TRANSACTION_STATE_LOG_REPLICATION_FACTOR=3
TRANSACTION_STATE_LOG_MIN_ISR=2

# Disable automatic topic creation for cleaner testing.
AUTO_CREATE_TOPICS_ENABLE=false

# Allow deleting topics in the lab.
DELETE_TOPIC_ENABLE=true

# Log retention in hours (168 = 7 days).
LOG_RETENTION_HOURS=168

# Optional broker DNS domain used for legacy-style SANs (KAFKA0001.hq.corp).
KAFKA_DOMAIN=hq.corp

###############################################################################
# Java Heap
###############################################################################

# Kafka JVM heap options.
KAFKA_HEAP_OPTS=-Xms512m -Xmx1g

# ZooKeeper JVM heap options.
ZOOKEEPER_HEAP_OPTS=-Xms256m -Xmx512m

###############################################################################
# Host Port Mapping
###############################################################################

# Internal Kafka ports remain:
#   PLAINTEXT = 9092
#   SSL       = 9093
#
# Host ports are generated per broker as <brokerIndex><suffix>:
#   kafka1 PLAINTEXT -> 19092      kafka1 SSL -> 19093
#   kafka2 PLAINTEXT -> 29092      kafka2 SSL -> 29093
#   kafka3 PLAINTEXT -> 39092      kafka3 SSL -> 39093
PLAINTEXT_PORT_SUFFIX=9092
SSL_PORT_SUFFIX=9093

###############################################################################
# Certificate Mode
###############################################################################

# Controls how certificates are handled.
#
# Supported values:
#   generate = generate a local Root CA, Intermediate CA, broker certs, and stores
#   import   = use user-provided CA and broker certificates
#
# generate is best for lab use.
# import is best when using an existing internal CA or enterprise PKI.
KAFKA_CERT_MODE=generate

###############################################################################
# Generated Certificate Settings
###############################################################################

# Password used for the Kafka PKCS12 keystores.
# (Trust material is PEM and needs no password.)
# Change this in real deployments.
KAFKA_SSL_PASSWORD=changeit

# Password used for generated CA private keys when KAFKA_CERT_MODE=generate.
KAFKA_CA_PASSWORD=changeit

# Organization fields used in generated certificates.
CERT_ORG=corp
CERT_ORG_UNIT=hq

# Certificate validity in days for generated lab certificates.
CERT_VALIDITY_DAYS=3650

# TLS versions enabled for Kafka SSL listeners.
SSL_ENABLED_PROTOCOLS=TLSv1.2,TLSv1.3

# Kafka client authentication mode.
#
# Supported values:
#   none     = clients only verify broker certificate
#   required = mutual TLS; clients must present certificates
#
# Default lab value: none
SSL_CLIENT_AUTH=none

###############################################################################
# User-Provided Certificate Paths  (used only when KAFKA_CERT_MODE=import)
###############################################################################

# Root CA certificate path on the host.
EXTERNAL_ROOT_CA_CERT=

# Optional intermediate CA certificate path on the host. Leave empty if not used.
EXTERNAL_INTERMEDIATE_CA_CERT=

# Directory containing broker certificates and private keys.
# Expected file naming convention:
#   kafka1.crt  kafka1.key
#   kafka2.crt  kafka2.key
#   kafka3.crt  kafka3.key   (and kafka4.* / kafka5.* for expanded clusters)
EXTERNAL_BROKER_CERTS_DIR=

# Optional client certificate and key for mutual TLS.
# Required only when SSL_CLIENT_AUTH=required and client certs are not generated.
EXTERNAL_CLIENT_CERT=
EXTERNAL_CLIENT_KEY=

###############################################################################
# Store Output Paths
###############################################################################

# Directory where generated or imported Kafka SSL material is written.
CERT_OUTPUT_DIR=certs/generated

# Keystore type used by Kafka. Prefer PKCS12 for modern Java.
# Trust material is always PEM (see docs/ssl-design.md).
KAFKA_STORE_TYPE=PKCS12
